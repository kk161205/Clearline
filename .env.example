# Copy this file to .env and fill in your Sandbox app credentials
# (Developer Dashboard -> Apps & Credentials -> your Sandbox app).
# Never commit .env or paste the secret anywhere.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_ENV=sandbox

# Local SQLite file that stores each order's timeline
DATABASE_PATH=clearline.db

# Webhook ID shown in Developer Dashboard -> your Sandbox app -> Webhooks after you add
# <tunnel URL>/webhooks/paypal. Without it, POST /webhooks/paypal returns 503.
PAYPAL_WEBHOOK_ID=

# DEV ONLY. true = accept webhooks whose signature can't be verified (the Dashboard's
# Webhook Simulator sends mock events that usually fail verification). Keep false otherwise.
ALLOW_UNVERIFIED_WEBHOOKS=false

# AI dispute assistant (Day 3). Free keys, no card needed:
#   Gemini: https://aistudio.google.com -> Get API key
#   Groq:   https://console.groq.com -> API Keys
# Gemini is used first. If it fails (rate limit, outage, bad key), Clearline switches to Groq
# and stays there until you POST /api/ai/reset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Seconds to wait for one AI reply before treating the provider as down
AI_TIMEOUT_SECONDS=20

# Safety net for missed webhooks (quick tunnels die): pull disputes from PayPal every N
# minutes in the background. Read-only; 0 turns it off.
AUTO_SYNC_MINUTES=3

# Day 4: secret that signs buyer order links (/o/<token>).
# Use a long random value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, a random one is generated at startup: buyer links then break on restart.
APP_SECRET=

# Seller accounts live in the database: create the first one at /setup (the setup code is in
# the server log), more with: python -m app.users create --email you@example.com
# true only behind a proxy you control (Render, ngrok): then X-Forwarded-Proto/-For count.
TRUST_PROXY=false

# The business name buyers see on their order page ("what is this charge?")
SELLER_DISPLAY_NAME=Demo Design Studio

# Day 5: your business's country (ISO code). IN = show the India export paperwork checklist
# (purpose code + FIRA) for payments received from abroad.
SELLER_COUNTRY=IN

# Day 6: keys for the read-only merchant tools on the MCP server (/mcp) are made in
# /seller -> Settings -> Agent access (not here).
