# Copy this file to .env and fill in your Sandbox app credentials
# (Developer Dashboard -> Apps & Credentials -> your Sandbox app).
# Never commit .env or paste the secret anywhere.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_ENV=sandbox

# Local SQLite file that stores each order's timeline
DATABASE_PATH=clearline.db

# Webhook ID shown in Developer Dashboard -> your Sandbox app -> Webhooks after you add
# <tunnel URL>/webhooks/paypal. Without it, POST /webhooks/paypal returns 503.
PAYPAL_WEBHOOK_ID=

# DEV ONLY. true = accept webhooks whose signature can't be verified (the Dashboard's
# Webhook Simulator sends mock events that usually fail verification). Keep false otherwise.
ALLOW_UNVERIFIED_WEBHOOKS=false

# AI dispute assistant (Day 3). Free keys, no card needed:
#   Gemini: https://aistudio.google.com -> Get API key
#   Groq:   https://console.groq.com -> API Keys
# Gemini is used first. If it fails (rate limit, outage, bad key), Clearline switches to Groq
# and stays there until you POST /api/ai/reset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Seconds to wait for one AI reply before treating the provider as down
AI_TIMEOUT_SECONDS=20
