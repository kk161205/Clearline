# Clearline's environment. Everything else is a code default or Settings -> Business on /seller.
# Render: set the first group in the service's Environment tab; Render provides RENDER,
# RENDER_EXTERNAL_URL and RENDER_GIT_COMMIT itself. Local: copy this file to .env.
# Never commit .env or paste a secret anywhere.

# ---- Required in production (the app refuses to start without them) ----------------------

# Postgres: Neon's connection string, with sslmode=require.
# Empty locally = the SQLite file clearline.db, for tests and UI checks.
DATABASE_URL=
# Signs buyer order links (/o/<token>); at least 32 characters in production.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it breaks every buyer link already sent. Empty locally = a random one per start.
APP_SECRET=
# Developer Dashboard -> Apps & Credentials -> your Sandbox app.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
# Developer Dashboard -> your Sandbox app -> Webhooks, for the Render URL + /webhooks/paypal.
# Local runs get no webhooks: use Sync disputes, or the auto-sync.
PAYPAL_WEBHOOK_ID=

# ---- AI: free keys, no card needed. Gemini first; if it fails Clearline moves to Groq --------

# https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# https://console.groq.com -> API Keys
GROQ_API_KEY=

# ---- Optional ------------------------------------------------------------------------------

# AG Studio licence for /insights. Empty = AG Studio shows its trial watermark.
AG_STUDIO_LICENSE_KEY=
# Public address for absolute links, e.g. a custom domain. Default on Render: RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
# Level for Clearline's logs. Default INFO.
LOG_LEVEL=INFO

# ---- Local only ----------------------------------------------------------------------------

# Run production mode's checks and headers on your own machine:
# APP_ENV=production
# Pick another SQLite file (the demo database, say). Default clearline.db. Ignored with a
# warning on Render.
# DATABASE_PATH=clearline-demo.db
# Accept webhooks whose signature can't be verified (the Webhook Simulator's mock events).
# The app refuses to start with this on in production.
# ALLOW_UNVERIFIED_WEBHOOKS=true

# Seller accounts live in the database: create the first one at /setup (the setup code is in
# the server log), more with: python -m app.users create --email you@example.com
# Agent keys for the MCP server's read-only merchant tools are made in /seller -> Settings ->
# Agent access.
